# Base URL of the dashboard read API. No trailing slash.
#
# Local:    make dashboard       (scripts/dashboard_local.py, port 8787)
# Deployed: the DashboardApiUrl stack output — `make outputs`
#
# Unset, the app renders a configuration banner instead of data. It has no
# built-in fallback and never invents values.
VITE_API_BASE_URL="http://127.0.0.1:8787"
