# NEXUS — local environment. Copy to .env and fill in.

#CockroachDB 
COCKROACH_DB_URL="postgresql://nexus_app:<pw>@<host>:26257/nexus?sslmode=verify-full&sslrootcert=$HOME/.postgresql/root.crt"

# Changefeed webhook
CHANGEFEED_SHARED_SECRET=""

# AWS  (us-east-1 & not 'aws-us-east-1' label)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Amazon Bedrock 
BEDROCK_MODEL_ID="anthropic.claude-opus-4-8"
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
EMBEDDING_DIM="1024"

# ccloud (Guardian, read-only)
CCLOUD_API_KEY=""

# App
ENVIRONMENT="development"
PORT=8000
LOG_LEVEL="INFO"
