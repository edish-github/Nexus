# NEXUS — local environment. Copy to .env and fill in.

#CockroachDB 
COCKROACH_DB_URL="postgresql://nexus_app:<pw>@<host>:26257/nexus?sslmode=verify-full&sslrootcert=$HOME/.postgresql/root.crt"

# Changefeed webhook
CHANGEFEED_SHARED_SECRET=""

# AWS  (us-east-1 & not 'aws-us-east-1' label)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Amazon Bedrock
# Inference-profile id (note the `us.` prefix). This model cannot be invoked by
# bare foundation-model id — Bedrock rejects it as "Operation not allowed".
BEDROCK_MODEL_ID="us.anthropic.claude-opus-5"
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
EMBEDDING_DIM="1024"

# Embedding backend: bedrock | local | auto
#   bedrock — Titan Text Embeddings V2 (production path)
#   local   — deterministic feature-hashing embedder, no network, for offline seeds
#   auto    — bedrock when AWS credentials resolve, otherwise local
# The two are different vector spaces: changing this means re-running `make seed`.
EMBEDDING_PROVIDER="auto"

# Live generator (make live)
GENERATOR_TICK_SECONDS="3"
GENERATOR_INGEST="1"

# Dashboard read API (make dashboard, and the deployed DashboardFunction).
# GENERATOR_URL is what the fleet ramp control proxies to; left empty, the
# control reports itself unconfigured rather than pretending a ramp started.
GENERATOR_URL="http://127.0.0.1:8000"
DASHBOARD_PORT="8787"
# Bounds every dashboard read. A table blocked by another transaction then
# degrades one panel instead of hanging the whole request.
DB_STATEMENT_TIMEOUT_MS="15000"

# ccloud (Guardian, read-only)
CCLOUD_API_KEY=""

# App
ENVIRONMENT="development"
PORT=8000
LOG_LEVEL="INFO"
